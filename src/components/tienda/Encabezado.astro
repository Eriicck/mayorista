---
import BotonCarrito from './BotonCarrito'
import Buscador from './Buscador'
---
<header class="sticky top-0 z-40 border-b border-gray-100 bg-white/95 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center gap-4 px-4 py-3">
    <a href="/" class="shrink-0 text-xl font-black tracking-tighter text-gray-900 md:text-2xl">
      MAYORISTA<span class="text-gray-500">ONLINE</span>
    </a>
    <div class="ml-auto hidden w-full max-w-md md:block">
      <Buscador client:idle />
    </div>
    <div class="ml-auto md:ml-0">
      <BotonCarrito client:idle />
    </div>
  </div>
  <div class="px-4 pb-3 md:hidden">
    <Buscador client:idle />
  </div>
</header>
