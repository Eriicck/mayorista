---
import '../styles/global.css'
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url'
import Encabezado from '../components/tienda/Encabezado.astro'
import Pie from '../components/tienda/Pie.astro'
import PanelCarrito from '../components/tienda/PanelCarrito'
import BotonCarrito from '../components/tienda/BotonCarrito'
import Avisos from '../components/ui/Avisos'
import { TIENDA } from '../config/tienda'

interface Props { titulo?: string; descripcion?: string }
const { titulo = `${TIENDA.nombre} — Distribuidora mayorista`, descripcion = TIENDA.descripcion } = Astro.props
const canonica = new URL(Astro.url.pathname, Astro.site)
const og = new URL('/og.jpg', Astro.site)
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo}</title>
  <meta name="description" content={descripcion} />
  <link rel="canonical" href={canonica} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content="#111827" />
  <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />

  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_AR" />
  <meta property="og:site_name" content={TIENDA.nombre} />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:url" content={canonica} />
  <meta property="og:image" content={og} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <slot name="head" />
</head>
<body class="flex min-h-dvh flex-col">
  <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[300] focus:rounded-lg focus:bg-gray-900 focus:px-4 focus:py-2 focus:text-white">Saltar al contenido</a>
  <Encabezado />
  <main id="contenido" class="flex-1">
    <slot />
  </main>
  <Pie />
  <BotonCarrito client:idle flotante />
  <PanelCarrito client:idle />
  <Avisos client:idle />
</body>
</html>
