---
import Tienda from '../layouts/Tienda.astro'
---
<Tienda titulo="Página no encontrada — Mayorista Online">
  <div class="mx-auto max-w-lg px-4 py-24 text-center">
    <p class="text-6xl font-black text-gray-200">404</p>
    <h1 class="mt-4 text-2xl font-black">Esta página no existe</h1>
    <p class="mt-2 text-gray-500">Puede que el link esté mal escrito o que la página se haya movido.</p>
    <a href="/" class="mt-6 inline-block rounded-xl bg-gray-900 px-6 py-3 font-bold text-white hover:bg-black">Ver el catálogo</a>
  </div>
</Tienda>
